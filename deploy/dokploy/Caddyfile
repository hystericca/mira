{
	admin off
	auto_https off
}

:8080 {
	root * /srv/mira-web/current
	encode zstd gzip

	header {
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "webgpu=(self)"
		X-Content-Type-Options "nosniff"
	}

	@wasm path *.wasm
	header @wasm Content-Type "application/wasm"

	handle / {
		rewrite * /mira_web.html
		file_server
	}

	@extensionless {
		not path *.*
	}
	handle @extensionless {
		try_files {path} {path}/ /mira_web.html
		file_server
	}

	handle {
		file_server
	}
}
